# Copy to .env and fill locally. NEVER commit .env.
# ---------------------------------------------------------------------------
# Phase 1 (shadow / read-only) needs NONE of the signing secrets below.
# It only reads public market data. The keys are listed so the same .env file
# carries over to Phase 2 (live) without edits.
# ---------------------------------------------------------------------------

# --- Variational (public metadata read is unauthenticated in Phase 1) ---
VARIATIONAL_TOKEN=

# --- RHC Lighter: DEDICATED SUBACCOUNT for the hedge bot ---
# MUST be a separate sub-account from the grid bot to avoid nonce collisions.
# account_index identifies the subaccount; api_key_index MUST be in 4..254
# (0..3 are platform-reserved). Phase 1 only uses ACCOUNT_INDEX for read-only
# account snapshots; PRIVATE_KEY / API_KEY_INDEX are unused until Phase 2.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_PRIVATE_KEY_FILE=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
